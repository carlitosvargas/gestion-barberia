datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

enum Rol {
  SUPER_ADMIN
  DUENO_EMPRESA
}

model Empresa {
  id            Int      @id @default(autoincrement())
  nombre        String
  logo          String?
  direccion     String?
  telefono      String?
  dias          String?   // Ej: "Lunes a Viernes"
  horarios      String?   // Ej: "09:00 - 18:00"
  activa        Boolean  @default(true) // Oculta o muestra la empresa al público
  creadoEn      DateTime @default(now())
  actualizadoEn DateTime @updatedAt
  usuarios      Usuario[]
  servicios     Servicio[]
  turnos        Turno[]
  pagos         Pago[]
}

model Usuario {
  id            Int      @id @default(autoincrement())
  nombre        String
  apellido      String
  telefono      String?
  email         String   @unique
  password      String
  rol           Rol      @default(DUENO_EMPRESA)
  empresaId     Int?
  empresa       Empresa? @relation(fields: [empresaId], references: [id])
  creadoEn      DateTime @default(now())
  actualizadoEn DateTime @updatedAt
}

model Cliente {
  id        Int      @id @default(autoincrement())
  nombre    String
  apellido  String
  telefono  String
  email     String?
  turnos    Turno[]
  creadoEn  DateTime @default(now())
}

model Servicio {
  id          Int      @id @default(autoincrement())
  nombre      String
  precio      Float
  duracion    Int      // en minutos
  empresaId   Int
  empresa     Empresa  @relation(fields: [empresaId], references: [id])
  turnos      Turno[]
  creadoEn    DateTime @default(now())
}

model Turno {
  id                  Int      @id @default(autoincrement())
  clienteId           Int
  cliente             Cliente  @relation(fields: [clienteId], references: [id])
  servicioId          Int
  servicio            Servicio @relation(fields: [servicioId], references: [id])
  empresaId           Int
  empresa             Empresa  @relation(fields: [empresaId], references: [id])
  fecha               DateTime
  estado              String   @default("PENDIENTE") // PENDIENTE, CONFIRMADO, CANCELADO, COMPLETADO
  estadoPago          String   @default("PENDIENTE") // PENDIENTE, PAGADO
  notificacionEnviada Boolean  @default(false)
  recordatorioEnviado Boolean  @default(false)
  pagos               Pago[]
  creadoEn            DateTime @default(now())
}

model Pago {
  id                Int      @id @default(autoincrement())
  turnoId           Int
  turno             Turno    @relation(fields: [turnoId], references: [id], onDelete: Cascade)
  empresaId         Int
  empresa           Empresa  @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  monto             Float
  estado            String   @default("PENDIENTE") // PENDIENTE, APROBADO, RECHAZADO
  metodoPago        String?  // MERCADOPAGO, EFECTIVO, TRANSFERENCIA
  mpPreferenceId    String?
  mpPaymentId       String?
  mpMerchantOrderId String?
  creadoEn          DateTime @default(now())
  actualizadoEn     DateTime @updatedAt
}
